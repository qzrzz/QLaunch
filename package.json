{
  "name": "qlaunchpad",
  "version": "1.0.13",
  "private": true,
  "description": "QLaunch — 简单高性能的 macOS Launchpad",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "debug": "bun scripts/debug.ts",
    "build": "bun scripts/release.ts --no-publish",
    "release": "bun scripts/release.ts",
    "run": "bun scripts/dev.ts",
    "clean": "bun scripts/clean.ts",
    "web:dev": "qpage --dev ./web ./dist-web",
    "web:build": "qpage ./web ./dist-web",
    "web:preview": "qpage --preview ./web ./dist-web",
    "web:i18n:codex": "codex exec 根据./web/translate.md完成翻译任务",
    "web:i18n:gemini": "agy -p 根据./web/translate.md完成翻译任务",
    "web:publish": "bun run qzrzz-com up ./dist-web ./QLaunch",
    "web:build-publish": "bun run bun web:build && bun run web:publish",
    "check": "SWIFT_MODULECACHE_PATH=/private/tmp/qlaunchpad-swift-module-cache CLANG_MODULE_CACHE_PATH=/private/tmp/qlaunchpad-clang-module-cache swift package describe",
    "test": "bun test"
  },
  "dependencies": {
    "@types/node": "26.2.0",
    "qpage": "link:qpage",
    "qrls": "link:qrls",
    "qzrzz-com": "link:qzrzz-com"
  },
  "packageManager": "bun@1.3.14",
  "buildNumber": 21
}
