{
  "name": "qlaunchpad",
  "version": "1.0.7",
  "private": true,
  "description": "QLaunch — 简单高性能的 macOS Launchpad",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "debug": "bun scripts/debug.ts",
    "build": "bun scripts/release.ts --no-publish",
    "release": "bun scripts/release.ts",
    "run": "bun scripts/dev.ts",
    "clean": "bun scripts/clean.ts",
    "web:dev": "qpage --dev ./web-new ./dist",
    "web:build": "qpage ./web-new ./dist",
    "check": "SWIFT_MODULECACHE_PATH=/private/tmp/qlaunchpad-swift-module-cache CLANG_MODULE_CACHE_PATH=/private/tmp/qlaunchpad-clang-module-cache swift package describe"
  },
  "dependencies": {
    "@types/node": "26.2.0",
    "qpage": "link:qpage"
  },
  "packageManager": "bun@1.3.14",
  "buildNumber": 10
}
